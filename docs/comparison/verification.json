      "works": [
        {
          "title": "Pediatric Savior",
          "content": "A GPT-based rapid-cycle simulator for pediatric airway training, built with Emory Pediatrics and Children's Healthcare of Atlanta.\nResidents run cases. Admins edit instructions. The system includes chat, a case editor, conversation history, and Auth0 roles.\nThe application uses React, Flask, MongoDB, and AWS.",
          "href": "https://github.com/JunyiZhou-Conny/Airway-Management-Assistant",
          "placeholder": false,
          "locked": true,
          "brokenImages": []
        },
        {
          "title": "speciesOT",
          "content": "Exploring how optimal transport can map mouse cells to human cells in a shared autoencoder latent space.\nA command-line toolkit brings model comparison, scorecards, and cluster workflows together. It lists models, prints a scorecard, and shows the sbatch chain a human still submits.\nThis work is in progress. Research results stay outside the public repository.",
          "href": "https://github.com/JunyiZhou-Conny/speciesOT",
          "placeholder": false,
          "locked": true,
          "brokenImages": []
        },
        {
          "title": "Job Search OS",
          "content": "An application workflow with a memory, running since July 2026.\nCursor defines the policy. Polar Browser carries out the workflow. GitHub records changes, and Google Sheets tracks each run.\nApplication submission follows explicit rules.",
          "href": "https://github.com/JunyiZhou-Conny/job-search-2026-2027-starter",
          "placeholder": false,
          "locked": true,
          "brokenImages": []
        },
        {
          "title": "scGen / CellOT autoresearch",
          "content": "Fairshare-aware ablation search on FASRC Cannon: submit experiments, watch results, reflect, and decide what to run next.\nThe director writes an agenda; the execution layer keeps carrying it out. This separates research planning from the cluster work that needs to continue.\nThe public repository describes the system. Unpublished scientific results remain private.",
          "href": "https://github.com/JunyiZhou-Conny/scgen-cellot-autoresearch",
          "placeholder": false,
          "locked": true,
          "brokenImages": []
        }
      ]
